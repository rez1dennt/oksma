Options -Indexes
DirectoryIndex index.php
RewriteEngine On

RewriteRule ^(?:config|data|docs|scripts|src|storage|templates|tests|tokens|tools|vendor)(?:/|$) - [F,L,NC]
RewriteRule ^catalog/([a-z0-9-]+)/?$ catalog.php?slug=$1 [QSA,L,NC]
RewriteRule ^product/([a-z0-9-]+)/?$ product.php?slug=$1 [QSA,L,NC]
RewriteRule ^privacy/?$ privacy.php [L,NC]
RewriteRule ^documents/?$ documents.php [L,NC]
RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]
RewriteRule ^robots\.txt$ robots.php [L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . 404.php [L]

<IfModule mod_mime.c>
  AddType application/pdf .pdf
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
