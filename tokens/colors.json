{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ОКСМА soft industrial-editorial palette with milk surfaces, green graphite and one restrained red action color.",
  "primitive": {
    "$description": "Raw palette values ordered for accessible semantic use.",
    "red": {
      "50": {"$type":"color","$value":"#fff2f0","$description":"Lightest red surface"},
      "100":{"$type":"color","$value":"#fbe1de","$description":"Light red surface"},
      "200":{"$type":"color","$value":"#f2b8b2","$description":"Soft red border"},
      "300":{"$type":"color","$value":"#e9877e","$description":"Muted red accent"},
      "400":{"$type":"color","$value":"#d85044","$description":"Bright red accent"},
      "500":{"$type":"color","$value":"#c52d23","$description":"Primary action red"},
      "600":{"$type":"color","$value":"#a8251d","$description":"Primary hover red"},
      "700":{"$type":"color","$value":"#9e221a","$description":"Accessible inline link"},
      "800":{"$type":"color","$value":"#8e201a","$description":"Primary active red"},
      "900":{"$type":"color","$value":"#741b16","$description":"Deep red"},
      "950":{"$type":"color","$value":"#3c0d0a","$description":"Darkest red"}
    },
    "neutral": {
      "50":{"$type":"color","$value":"#fffdfa","$description":"Warm card white"},
      "100":{"$type":"color","$value":"#f5f3ef","$description":"Milk page canvas"},
      "200":{"$type":"color","$value":"#ebe8e1","$description":"Warm inset surface"},
      "300":{"$type":"color","$value":"#dedbd3","$description":"Decorative hairline border"},
      "400":{"$type":"color","$value":"#a8b0ac","$description":"Muted graphite"},
      "500":{"$type":"color","$value":"#7c8782","$description":"Essential control border"},
      "600":{"$type":"color","$value":"#65706c","$description":"Tertiary text"},
      "700":{"$type":"color","$value":"#4f5a56","$description":"Secondary text"},
      "800":{"$type":"color","$value":"#323d39","$description":"Raised graphite surface"},
      "900":{"$type":"color","$value":"#25302d","$description":"Deep green graphite"},
      "950":{"$type":"color","$value":"#202523","$description":"Primary ink"}
    },
    "gold": {
      "50":{"$type":"color","$value":"#fffaf0","$description":"Lightest champagne"},
      "100":{"$type":"color","$value":"#fff3cf","$description":"Warm pale champagne"},
      "200":{"$type":"color","$value":"#f4e1ad","$description":"Pale gold"},
      "300":{"$type":"color","$value":"#e7cb83","$description":"Footer gold highlight"},
      "400":{"$type":"color","$value":"#b88a32","$description":"Bright brand gold"},
      "500":{"$type":"color","$value":"#8a641f","$description":"Accessible gold text on light surfaces"},
      "600":{"$type":"color","$value":"#79561c","$description":"Gold hover on light surfaces"},
      "700":{"$type":"color","$value":"#674817","$description":"Deep gold"},
      "800":{"$type":"color","$value":"#503716","$description":"Darker gold"},
      "900":{"$type":"color","$value":"#3a2917","$description":"Near-brown gold"},
      "950":{"$type":"color","$value":"#241a10","$description":"Darkest gold"}
    },
    "warmDark": {
      "900":{"$type":"color","$value":"#2f291f","$description":"Raised warm graphite"},
      "950":{"$type":"color","$value":"#211d17","$description":"Footer warm graphite"}
    },
    "surface": {
      "sand":{"$type":"color","$value":"#e7e3da","$description":"Warm request section"},
      "sage":{"$type":"color","$value":"#e3e7e1","$description":"Soft industrial accent surface"}
    },
    "offWhite":{"$type":"color","$value":"#f8f5ef","$description":"Warm text on graphite"},
    "green":{"$type":"color","$value":"#2d704d","$description":"Success green"}
  },
  "semantic": {
    "$description":"Purpose-based light theme tokens.",
    "action": {
      "primary":{"$type":"color","$value":"{primitive.red.500}","$description":"Primary conversion action"},
      "primary-hover":{"$type":"color","$value":"{primitive.red.600}","$description":"Primary hover"},
      "primary-active":{"$type":"color","$value":"{primitive.red.800}","$description":"Primary pressed"},
      "secondary":{"$type":"color","$value":"{primitive.neutral.50}","$description":"Neutral secondary action"},
      "secondary-hover":{"$type":"color","$value":"{primitive.neutral.200}","$description":"Secondary hover"}
    },
    "text": {
      "primary":{"$type":"color","$value":"{primitive.neutral.950}","$description":"Primary page text"},
      "secondary":{"$type":"color","$value":"{primitive.neutral.700}","$description":"Supporting page text"},
      "tertiary":{"$type":"color","$value":"{primitive.neutral.600}","$description":"Incidental text"},
      "on-action":{"$type":"color","$value":"{primitive.neutral.50}","$description":"Text on red actions"},
      "on-dark":{"$type":"color","$value":"{primitive.offWhite}","$description":"Text on graphite"},
      "on-dark-muted":{"$type":"color","$value":"{primitive.neutral.300}","$description":"Supporting text on graphite"},
      "link":{"$type":"color","$value":"{primitive.red.700}","$description":"Inline links"},
      "link-hover":{"$type":"color","$value":"{primitive.red.900}","$description":"Inline link hover"}
    },
    "surface": {
      "page":{"$type":"color","$value":"{primitive.neutral.100}","$description":"Page canvas"},
      "card":{"$type":"color","$value":"{primitive.neutral.50}","$description":"Card surface"},
      "raised":{"$type":"color","$value":"{primitive.neutral.50}","$description":"Raised surface"},
      "sunken":{"$type":"color","$value":"{primitive.neutral.200}","$description":"Inset surface"},
      "tint":{"$type":"color","$value":"{primitive.surface.sand}","$description":"Warm section surface"},
      "sage":{"$type":"color","$value":"{primitive.surface.sage}","$description":"Soft green industrial surface"},
      "dark":{"$type":"color","$value":"{primitive.neutral.900}","$description":"Graphite section"},
      "dark-raised":{"$type":"color","$value":"{primitive.neutral.800}","$description":"Raised graphite section"}
    },
    "border": {
      "default":{"$type":"color","$value":"{primitive.neutral.300}","$description":"Decorative border"},
      "strong":{"$type":"color","$value":"{primitive.neutral.500}","$description":"Essential control border"},
      "focus":{"$type":"color","$value":"{primitive.red.500}","$description":"Keyboard focus"},
      "error":{"$type":"color","$value":"{primitive.red.700}","$description":"Invalid field border"}
    },
    "feedback": {
      "success":{"$type":"color","$value":"{primitive.green}","$description":"Success text and icon"},
      "error":{"$type":"color","$value":"{primitive.red.700}","$description":"Error text and icon"}
    },
    "footer": {
      "background":{"$type":"color","$value":"{primitive.warmDark.950}","$description":"Warm graphite footer background"},
      "raised":{"$type":"color","$value":"{primitive.warmDark.900}","$description":"Footer borders and raised surfaces"},
      "text":{"$type":"color","$value":"#fff8e9","$description":"Primary footer text"},
      "muted":{"$type":"color","$value":"#d9cfb7","$description":"Supporting footer text"},
      "accent":{"$type":"color","$value":"{primitive.gold.300}","$description":"Gold footer accent"},
      "accent-hover":{"$type":"color","$value":"{primitive.gold.100}","$description":"Footer link hover"}
    }
  },
  "component": {
    "$description":"Component-specific aliases.",
    "button": {
      "primary-bg":{"$type":"color","$value":"{semantic.action.primary}","$description":"Primary button background"},
      "primary-hover":{"$type":"color","$value":"{semantic.action.primary-hover}","$description":"Primary button hover"},
      "primary-active":{"$type":"color","$value":"{semantic.action.primary-active}","$description":"Primary button pressed"},
      "primary-text":{"$type":"color","$value":"{semantic.text.on-action}","$description":"Primary button label"}
    },
    "input": {
      "bg":{"$type":"color","$value":"{semantic.surface.card}","$description":"Input surface"},
      "border":{"$type":"color","$value":"{semantic.border.strong}","$description":"Input boundary"},
      "focus":{"$type":"color","$value":"{semantic.border.focus}","$description":"Input focus boundary"},
      "error":{"$type":"color","$value":"{semantic.border.error}","$description":"Input error boundary"}
    }
  },
  "dark": {
    "$description":"Semantic overrides for a dark document theme.",
    "text": {
      "primary":{"$type":"color","$value":"{primitive.offWhite}","$description":"Primary dark-theme text"},
      "secondary":{"$type":"color","$value":"{primitive.neutral.300}","$description":"Secondary dark-theme text"},
      "tertiary":{"$type":"color","$value":"{primitive.neutral.400}","$description":"Tertiary dark-theme text"},
      "on-action":{"$type":"color","$value":"{primitive.neutral.50}","$description":"Action label in dark theme"},
      "link":{"$type":"color","$value":"{primitive.red.200}","$description":"Dark-theme links"},
      "link-hover":{"$type":"color","$value":"{primitive.red.100}","$description":"Dark-theme link hover"}
    },
    "surface": {
      "page":{"$type":"color","$value":"{primitive.neutral.950}","$description":"Dark page canvas"},
      "card":{"$type":"color","$value":"{primitive.neutral.900}","$description":"Dark card"},
      "raised":{"$type":"color","$value":"{primitive.neutral.800}","$description":"Dark raised surface"}
    },
    "border": {
      "default":{"$type":"color","$value":"{primitive.neutral.700}","$description":"Dark decorative border"},
      "strong":{"$type":"color","$value":"{primitive.neutral.400}","$description":"Dark essential border"}
    },
    "action": {
      "primary":{"$type":"color","$value":"{primitive.red.500}","$description":"Dark-theme action"},
      "primary-hover":{"$type":"color","$value":"{primitive.red.600}","$description":"Dark-theme action hover"}
    }
  }
}
